datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  MANAGER
  TENANT
  OWNER
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  CONDO
  TOWNHOUSE
}

enum UnitStatus {
  VACANT
  OCCUPIED
  NOTICE
  MAINTENANCE
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
  WAIVED
}

enum PaymentMethod {
  ONLINE
  CHECK
  CASH
  ACH
  MONEY_ORDER
}

enum MaintenancePriority {
  EMERGENCY
  HIGH
  MEDIUM
  LOW
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  PENDING_PARTS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DENIED
  WITHDRAWN
}

enum DocumentCategory {
  LEASE
  INSPECTION
  NOTICE
  RECEIPT
  PHOTO
  OTHER
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LeadSource {
  WEBSITE
  ZILLOW
  APARTMENTS_COM
  REFERRAL
  WALK_IN
  OTHER
}

enum InspectionType {
  MOVE_IN
  MOVE_OUT
  PERIODIC
}

enum LeadStatus {
  NEW
  CONTACTED
  TOURED
  APPLIED
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(TENANT)
  phone        String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant?
  owner    Owner?
  messages Message[] @relation("SentMessages")
  tasks    Task[]
}

model Property {
  id          String       @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  zip         String
  type        PropertyType @default(APARTMENT)
  description String?
  yearBuilt   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  units      Unit[]
  ownerships PropertyOwnership[]
  documents  Document[]
  leads      Lead[]
}

model Unit {
  id          String     @id @default(cuid())
  propertyId  String
  unitNumber  String
  bedrooms    Int
  bathrooms   Float
  sqft        Int?
  rentAmount  Float
  deposit     Float?
  status      UnitStatus @default(VACANT)
  floor       Int?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  property             Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases               Lease[]
  maintenanceRequests  MaintenanceRequest[]
  documents            Document[]
  applications         Application[]
  inspections          Inspection[]
  leads                Lead[]
}

model Tenant {
  id                String   @id @default(cuid())
  userId            String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  phone             String
  dateOfBirth       DateTime?
  emergencyContacts Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leases    Lease[]
  payments  Payment[]
  documents Document[]
}

model Lease {
  id            String      @id @default(cuid())
  unitId        String
  tenantId      String
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float
  deposit       Float
  petDeposit    Float?
  petAllowed    Boolean     @default(false)
  status        LeaseStatus @default(PENDING)
  renewalStatus String?
  notes         String?
  signedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payments  Payment[]
  documents Document[]
}

model Payment {
  id              String         @id @default(cuid())
  leaseId         String
  tenantId        String
  amount          Float
  amountDue       Float
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  dueDate         DateTime
  paidAt          DateTime?
  lateFee         Float?
  notes           String?
  referenceNumber String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lease  Lease  @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model MaintenanceRequest {
  id            String              @id @default(cuid())
  unitId        String
  requestedBy   String
  title         String
  description   String
  priority      MaintenancePriority @default(MEDIUM)
  status        MaintenanceStatus   @default(OPEN)
  category      String
  vendorId      String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  notes         String?
  estimatedCost Float?
  actualCost    Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vendor     Vendor?     @relation(fields: [vendorId], references: [id])
  workOrders WorkOrder[]
}

model WorkOrder {
  id          String    @id @default(cuid())
  requestId   String
  vendorId    String
  description String
  scheduledAt DateTime?
  completedAt DateTime?
  cost        Float?
  notes       String?
  createdAt   DateTime  @default(now())

  request MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendor  Vendor             @relation(fields: [vendorId], references: [id])
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  trade         String
  contactName   String
  email         String?
  phone         String
  address       String?
  licenseNumber String?
  insured       Boolean  @default(false)
  rating        Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
}

model Owner {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  address   String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerships PropertyOwnership[]
}

model PropertyOwnership {
  id             String    @id @default(cuid())
  propertyId     String
  ownerId        String
  ownershipShare Float
  startDate      DateTime
  endDate        DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, ownerId])
}

model Document {
  id         String           @id @default(cuid())
  name       String
  category   DocumentCategory @default(OTHER)
  url        String
  mimeType   String
  sizeBytes  Int?
  propertyId String?
  unitId     String?
  tenantId   String?
  leaseId    String?
  uploadedBy String
  createdAt  DateTime         @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  lease    Lease?    @relation(fields: [leaseId], references: [id])
}

model Message {
  id          String    @id @default(cuid())
  threadId    String
  senderId    String
  receiverIds String[]
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender User @relation("SentMessages", fields: [senderId], references: [id])
}

model Application {
  id             String            @id @default(cuid())
  unitId         String
  applicantName  String
  applicantEmail String
  applicantPhone String
  income         Float?
  employerName   String?
  creditScore    Int?
  references     String?
  status         ApplicationStatus @default(PENDING)
  notes          String?
  submittedAt    DateTime          @default(now())
  decidedAt      DateTime?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Inspection {
  id          String           @id @default(cuid())
  unitId      String
  type        InspectionType
  status      InspectionStatus @default(SCHEDULED)
  scheduledAt DateTime
  completedAt DateTime?
  rooms       Json             @default("{}")
  photos      String[]
  notes       String?
  conductedBy String
  createdAt   DateTime         @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String
  phone      String?
  propertyId String?
  unitId     String?
  source     LeadSource @default(WEBSITE)
  notes      String?
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])
}

model Task {
  id          String              @id @default(cuid())
  title       String
  description String?
  assignedTo  String
  dueDate     DateTime?
  priority    MaintenancePriority @default(MEDIUM)
  status      TaskStatus          @default(TODO)
  createdAt   DateTime            @default(now())

  assignee User @relation(fields: [assignedTo], references: [id])
}
